generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(PARENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  announcements Announcement[]

  userClassrooms UserClassroom[]

  ownedClassrooms            Classroom[]                @relation("ClassroomOwner")
  sessions                   AuthSession[]
  pushRegistrations          PushRegistration[]
  announcementPushDispatches AnnouncementPushDispatch[]
}

model AuthSession {
  id               String    @id
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user                       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushRegistrations          PushRegistration[]
  announcementPushDispatches AnnouncementPushDispatch[]

  @@index([userId])
}

model ClassroomDeletionReceipt {
  classroomId String   @id
  ownerId     String
  deletedAt   DateTime @default(now())
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  expiresAt DateTime

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  notificationPending Boolean?
  pushEvents          AnnouncementPushEvent[]

  @@index([notificationPending, createdAt, id])
}

model Classroom {
  id      String @id @default(uuid())
  name    String
  ownerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  announcements Announcement[]

  userClassrooms UserClassroom[]

  owner User @relation("ClassroomOwner", fields: [ownerId], references: [id])
}

model UserClassroom {
  userId      String
  classroomId String

  user      User      @relation(fields: [userId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@id([userId, classroomId])
}

model InviteCode {
  id        String   @id @default(uuid())
  code      String   @unique
  role      Role
  isActive  Boolean  @default(true)
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  PARENT
  PROFESSOR
  ADMIN
}

enum PushPlatform {
  ANDROID
  IOS
}

enum PushRegistrationState {
  RESERVED
  ACTIVE
  REVOKED
  INVALID
}

enum PushRegistrationReason {
  USER_DISABLED
  LOGOUT
  PERMISSION_REVOKED
  SESSION_INACTIVE
  TOKEN_INVALID
  REPLACED
}

enum PushTestAttemptState {
  SENDING
  ACCEPTED
  PROVIDER_HANDOFF
  REJECTED
  UNKNOWN
}

model PushInstallation {
  id                  String    @id @db.Uuid
  secretHash          String    @db.Char(64)
  lifecycleVersion    Int       @default(0)
  lastTestStartedAt   DateTime? @db.Timestamptz(6)
  nextTestAvailableAt DateTime? @db.Timestamptz(6)
  testLeaseUntil      DateTime? @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  registrations          PushRegistration[]
  testAttempts           PushTestAttempt[]
  announcementDispatches AnnouncementPushDispatch[]
}

model PushRegistration {
  id               String                  @id @default(uuid()) @db.Uuid
  installationId   String                  @db.Uuid
  userId           String
  sessionId        String
  lifecycleVersion Int
  platform         PushPlatform?
  expoToken        String?                 @unique
  tokenFingerprint String?                 @db.Char(64)
  tokenRevision    Int                     @default(0)
  state            PushRegistrationState   @default(RESERVED)
  reason           PushRegistrationReason?
  createdAt        DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  activatedAt      DateTime?               @db.Timestamptz(6)
  invalidatedAt    DateTime?               @db.Timestamptz(6)

  installation           PushInstallation           @relation(fields: [installationId], references: [id], onDelete: Cascade)
  user                   User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  session                AuthSession                @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  testAttempts           PushTestAttempt[]
  announcementDispatches AnnouncementPushDispatch[]

  @@unique([installationId, lifecycleVersion])
  @@index([userId])
  @@index([sessionId])
  @@index([installationId, state])
}

model PushTestAttempt {
  id                 String               @id @default(uuid()) @db.Uuid
  installationId     String               @db.Uuid
  registrationId     String               @db.Uuid
  tokenRevision      Int
  tokenFingerprint   String               @db.Char(64)
  state              PushTestAttemptState @default(SENDING)
  failureCode        String?
  providerTicketId   String?              @db.VarChar(256)
  startedAt          DateTime             @default(now()) @db.Timestamptz(6)
  acceptedAt         DateTime?            @db.Timestamptz(6)
  completedAt        DateTime?            @db.Timestamptz(6)
  nextReceiptCheckAt DateTime?            @db.Timestamptz(6)
  receiptDeadlineAt  DateTime?            @db.Timestamptz(6)
  receiptLeaseUntil  DateTime?            @db.Timestamptz(6)
  receiptChecks      Int                  @default(0)

  installation PushInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  registration PushRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([state, nextReceiptCheckAt])
}

enum AnnouncementPushKind {
  NEW
  EXPIRING
}

enum AnnouncementPushDispatchState {
  PENDING
  CLAIMED
  SENDING
  ACCEPTED
  PROVIDER_HANDOFF
  REJECTED
  UNKNOWN
  SUPPRESSED
}

model AnnouncementPushEvent {
  id             String                     @id @default(uuid()) @db.Uuid
  announcementId String
  kind           AnnouncementPushKind
  snapshotAt     DateTime                   @db.Timestamptz(6)
  createdAt      DateTime                   @default(now()) @db.Timestamptz(6)
  announcement   Announcement               @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  dispatches     AnnouncementPushDispatch[]

  occurrenceKey String @default("publication") @db.VarChar(40)

  @@unique([announcementId, kind, occurrenceKey])
}

model AnnouncementPushDispatch {
  id                 String                        @id @default(uuid()) @db.Uuid
  eventId            String                        @db.Uuid
  installationId     String                        @db.Uuid
  registrationId     String                        @db.Uuid
  userId             String
  sessionId          String
  lifecycleVersion   Int
  tokenRevision      Int
  tokenFingerprint   String                        @db.Char(64)
  state              AnnouncementPushDispatchState @default(PENDING)
  claimVersion       Int                           @default(0)
  leaseUntil         DateTime?                     @db.Timestamptz(6)
  sendStartedAt      DateTime?                     @db.Timestamptz(6)
  providerTicketId   String?                       @db.VarChar(256)
  failureCode        String?                       @db.VarChar(64)
  acceptedAt         DateTime?                     @db.Timestamptz(6)
  completedAt        DateTime?                     @db.Timestamptz(6)
  nextReceiptCheckAt DateTime?                     @db.Timestamptz(6)
  receiptDeadlineAt  DateTime?                     @db.Timestamptz(6)
  receiptLeaseUntil  DateTime?                     @db.Timestamptz(6)
  receiptChecks      Int                           @default(0)
  createdAt          DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                      @default(now()) @updatedAt @db.Timestamptz(6)

  event        AnnouncementPushEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  installation PushInstallation      @relation(fields: [installationId], references: [id], onDelete: Cascade)
  registration PushRegistration      @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  session      AuthSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([eventId, installationId])
  @@index([state, leaseUntil])
  @@index([state, createdAt])
  @@index([state, nextReceiptCheckAt])
  @@index([userId])
  @@index([sessionId])
  @@index([registrationId])
}
