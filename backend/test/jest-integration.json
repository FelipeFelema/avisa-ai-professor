{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/.*\\.(integration|contract)\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "setupFilesAfterEnv": ["<rootDir>/test/helpers/test-environment.ts"],
  "testTimeout": 30000,
  "testPathIgnorePatterns": ["/node_modules/"]
}
