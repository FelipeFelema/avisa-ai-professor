{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "setupFilesAfterEnv": ["<rootDir>/helpers/test-environment.ts"],
  "testTimeout": 30000,
  "testPathIgnorePatterns": ["/node_modules/"],
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
