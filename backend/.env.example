DATABASE_URL="postgresql://postgres:postgres@localhost:5432/avisa_ai"

JWT_ACCESS_SECRET="replace_with_a_strong_access_secret"
JWT_REFRESH_SECRET="replace_with_a_strong_refresh_secret"

PORT=3000

NODE_ENV=development
API_DOCS_ENABLED=true

# Push delivery is disabled unless its private Expo access token is configured.
EXPO_PUSH_ENABLED=false
ANNOUNCEMENT_PUSH_ENABLED=false
ANNOUNCEMENT_PUSH_REMINDERS_ENABLED=false
# Required only when EXPO_PUSH_ENABLED=true; keep this secret out of mobile builds.
EXPO_PUSH_ACCESS_TOKEN=replace_with_a_secure_expo_push_access_token
